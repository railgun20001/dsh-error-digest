{
  "name": "dsh-error-digest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH 对话错误汇总：折叠会话日志里的工具失败、回合失败与模型重试，跨会话合并后按出现频次排序，每条错误可一键开启「分析」或「防范」对话",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "build/bundle.mjs",
    "src",
    "test",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build/bundle.mjs",
    "test": "node --test test/digest-fold-test.mjs test/digest-model-test.mjs test/bundle-test.mjs test/client-half-test.mjs",
    "check": "node build/bundle.mjs --check && node --test test/digest-fold-test.mjs test/digest-model-test.mjs test/bundle-test.mjs test/client-half-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
